{
  "name": "rene-website-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "admin:init": "node -e \"require('./dist/admin/initAdmin').runInitAdminCli(process.argv.slice(1)).catch((error) => { console.error(error instanceof Error ? error.message : error); process.exit(1); })\" --",
    "communes:import": "node -e \"require('./dist/communes/importCli').runCommunesImportCli().catch((error) => { console.error(error instanceof Error ? error.message : error); process.exit(1); })\"",
    "lint": "eslint . --ext .ts",
    "test": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:backfill-event-slugs": "ts-node prisma/backfillEventSlugs.ts",
    "prisma:backfill-legacy-uploads": "ts-node prisma/backfillLegacyUploads.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "prisma": "6.12.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "22.20.4",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.0.0",
    "jest": "^30.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
