generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum EventRevisionStatus {
  DRAFT
  PENDING
  REJECTED
}

enum GeolocationPrecision {
  EXACT
  APPROXIMATE
  UNRESOLVED
}

enum UserRole {
  EDITOR
  MODERATOR
  ADMIN
}

enum ModerationReminderTarget {
  EVENT
  REVISION
}

model Event {
  id                     String      @id @default(uuid()) @db.Uuid
  title                  String
  content                String?
  image                  String?
  imageAlt               String?
  seoTitleOverride       String?
  seoDescriptionOverride String?
  createdByUserId        String?     @db.Uuid
  categoryId             String?
  audienceId             String?
  organizerName          String?
  organizerUrl           String?
  contactEmail           String?
  contactPhone           String?
  ticketUrl              String?
  pricingInfo            String?
  websiteUrl             String?
  socialLinks            Json?
  slug                   String?     @unique
  status                 EventStatus @default(DRAFT)
  featured               Boolean     @default(false)
  publishedAt            DateTime?
  publicationEndAt       DateTime
  rejectionReason        String?
  archivedAt             DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  audience            Audience?            @relation(fields: [audienceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser       User?                @relation("UserCreatedEvents", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  pendingRevision     EventRevision?
  occurrences         EventOccurrence[]
  moderationReminders ModerationReminder[]
  slugRedirects       EventSlugRedirect[]

  @@index([status])
  @@index([featured])
  @@index([categoryId])
  @@index([audienceId])
  @@index([createdByUserId])
  @@index([archivedAt])
}

// Minimal history of an event's previous slugs, so a link built before an explicit slug change
// keeps resolving (301) to the event's current canonical URL instead of breaking.
model EventSlugRedirect {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  slug      String   @unique
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([eventId])
}

model ModerationReminder {
  id      String                   @id @default(uuid()) @db.Uuid
  eventId String                   @db.Uuid
  target  ModerationReminderTarget
  sentAt  DateTime                 @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([eventId, target])
}

model EventOccurrence {
  id                   String               @id @default(uuid()) @db.Uuid
  eventId              String               @db.Uuid
  venueName            String?
  address              String?
  postalCode           String?
  city                 String?
  latitude             Float?
  longitude            Float?
  geolocationPrecision GeolocationPrecision @default(UNRESOLVED)
  eventStartAt         DateTime?
  eventEndAt           DateTime?
  allDay               Boolean?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([eventId])
  @@index([eventStartAt])
}

model EventRevision {
  id                     String              @id @default(uuid()) @db.Uuid
  eventId                String              @unique @db.Uuid
  title                  String
  content                String?
  image                  String?
  imageAlt               String?
  seoTitleOverride       String?
  seoDescriptionOverride String?
  createdByUserId        String?             @db.Uuid
  categoryId             String?
  audienceId             String?
  organizerName          String?
  organizerUrl           String?
  contactEmail           String?
  contactPhone           String?
  ticketUrl              String?
  pricingInfo            String?
  websiteUrl             String?
  socialLinks            Json?
  status                 EventRevisionStatus @default(PENDING)
  featured               Boolean             @default(false)
  rejectionReason        String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  event         Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category      Category?                 @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  audience      Audience?                 @relation(fields: [audienceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser User?                     @relation("UserCreatedRevisions", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  occurrences   EventRevisionOccurrence[]

  @@index([status])
  @@index([categoryId])
  @@index([audienceId])
  @@index([createdByUserId])
}

model EventRevisionOccurrence {
  id                   String               @id @default(uuid()) @db.Uuid
  eventRevisionId      String               @db.Uuid
  venueName            String?
  address              String?
  postalCode           String?
  city                 String?
  latitude             Float?
  longitude            Float?
  geolocationPrecision GeolocationPrecision @default(UNRESOLVED)
  eventStartAt         DateTime?
  eventEndAt           DateTime?
  allDay               Boolean?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  eventRevision EventRevision @relation(fields: [eventRevisionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([eventRevisionId])
  @@index([eventStartAt])
}

model Category {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        Event[]
  revisions     EventRevision[]
  unsubscribers CategoryUnsubscription[]
}

model CategoryUnsubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, categoryId])
}

model Audience {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    Event[]
  revisions EventRevision[]
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  role            UserRole
  passwordHash    String
  sessionVersion  Int       @default(0)
  emailVerifiedAt DateTime? @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdEvents           Event[]                  @relation("UserCreatedEvents")
  createdRevisions        EventRevision[]          @relation("UserCreatedRevisions")
  passwordResetTokens     PasswordResetToken[]
  categoryUnsubscriptions CategoryUnsubscription[]
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
}

model AuthSession {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  sessionVersion   Int
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @unique @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @unique @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
}

model AuthRateLimit {
  key             String    @id
  attempts        Int
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt
}

model Commune {
  id                  String @id @default(uuid()) @db.Uuid
  codeInsee           String
  codePostal          String
  nomCommune          String
  libelleAcheminement String

  @@unique([codeInsee, codePostal])
  @@index([codePostal])
  @@index([nomCommune])
}

model SiteSetting {
  id               String   @id @default("default")
  contactEmail     String   @default("contact@rene-website.test")
  contactPhone     String   @default("0102030405")
  homepageIntro    String   @default("Plateforme culturelle de Descartes.")
  homepageSubtitle String   @default("")
  legalNotice      String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
